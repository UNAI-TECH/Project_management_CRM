# UNAI PM CRM Environment Variables for Vercel Deployment
# Configure these variables in: Vercel Dashboard -> Project -> Settings -> Environment Variables

# 1. Onboarding Platform Supabase (User Auth & Roles)
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# 2. PM CRM Dedicated Supabase (Projects, Tasks, Documents)
VITE_PM_CRM_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_PM_CRM_SUPABASE_ANON_KEY=your-supabase-anon-key

# 3. Application Identifier
VITE_CRM_NAME=pm_crm
